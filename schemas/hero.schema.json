{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tns.local/hero.schema.json",
  "title": "Форма героя",
  "description": "Раздел hero в config/world.json: что игра спрашивает у игрока при рождении героя. Состав полей — данные, поэтому меняется правкой конфига без пересборки.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "fields"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "description": "пояснение над формой: что здесь спрашивают и зачем"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "description": "поля в порядке показа; порядок значим",
      "items": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "имя поля: латиница в нижнем регистре, цифры и подчёркивание"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "description": "подсказка под полем"
        },
        "type": {
          "type": "string",
          "enum": ["text", "choice"],
          "description": "текст или выбор из вариантов"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "предел текста в символах; у выбора не задаётся"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "варианты выбора; обязательны при type=choice"
        },
        "default": {
          "type": "string",
          "description": "значение, которым поле заполнено при показе формы"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"type": {"const": "choice"}},
            "required": ["type"]
          },
          "then": {
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "text"}},
            "required": ["type"]
          },
          "then": {
            "not": {"required": ["options"]}
          }
        }
      ]
    }
  }
}
