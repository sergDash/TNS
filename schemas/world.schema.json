{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tns.local/world.schema.json",
  "title": "Мир: канон, форма героя и настройки",
  "description": "Канонические перечни мира, форма героя и форма config/world.json. Канон живёт здесь; в конфиге — только выбранное: какие языки включены и чем заполнены поля героя.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "langs",
    "hero"
  ],
  "properties": {
    "langs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "включённые языковые пакеты: значения из #/$defs/lang",
      "items": {
        "$ref": "#/$defs/lang"
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "description": "чем заполнены поля героя при показе формы",
      "properties": {
        "defaults": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "поле героя → значение по умолчанию"
        }
      }
    }
  },
  "$defs": {
    "genre": {
      "type": "string",
      "enum": [
        "фэнтези",
        "тёмное фэнтези",
        "городское фэнтези",
        "научная фантастика",
        "космоопера",
        "киберпанк",
        "стимпанк",
        "постапокалипсис",
        "LitRPG",
        "мифология",
        "исторический",
        "альтернативная история",
        "хоррор",
        "мистика",
        "триллер",
        "детектив",
        "приключения",
        "морское приключение",
        "вестерн",
        "любовный",
        "семейная сага",
        "подростковый",
        "драма",
        "философский",
        "социальная фантастика",
        "антиутопия",
        "сатира",
        "юмор",
        "фанфик",
        "современная проза"
      ],
      "description": "жанры мира"
    },
    "social_order": {
      "type": "string",
      "enum": [
        "нет",
        "феодализм",
        "демократия",
        "анархия",
        "теократия",
        "коммунизм",
        "капитализм",
        "социализм",
        "трайбализм",
        "рабовладение",
        "меркантилизм",
        "абсолютная монархия",
        "конституционная монархия",
        "олигархия",
        "технократия",
        "корпоратократия",
        "военная диктатура",
        "кастовая система"
      ],
      "description": "строи мира"
    },
    "travel_mode": {
      "type": "string",
      "enum": [
        "реальная",
        "вымышленная",
        "смешанная"
      ],
      "description": "режимы походов"
    },
    "economy_mod": {
      "type": "string",
      "enum": [
        "золотой стандарт",
        "серебряная экономика",
        "бартер",
        "командная экономика",
        "фиатные деньги",
        "кредитная экономика",
        "ресурсная экономика",
        "гильдейская"
      ],
      "description": "экономические модификаторы"
    },
    "rating": {
      "type": "string",
      "enum": [
        "16+",
        "18+",
        "21+"
      ],
      "description": "возрастные рейтинги"
    },
    "lang": {
      "type": "string",
      "enum": [
        "ru",
        "en",
        "de",
        "fr",
        "es",
        "ja",
        "zh"
      ],
      "description": "языки мира"
    },
    "estate": {
      "type": "string",
      "enum": [
        "военный/служащий",
        "купец",
        "аристократ",
        "духовенство",
        "ремесленник",
        "крестьянин"
      ],
      "description": "сословия героя"
    },
    "arrival": {
      "type": "string",
      "enum": [
        "очнулся в чужом теле",
        "призван ритуалом",
        "погиб и вернулся",
        "шёл и не заметил, как оказался здесь"
      ],
      "description": "как герой оказался в мире"
    },
    "heroAnswers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "estate",
        "arrival"
      ],
      "description": "Кем герой был в этом мире и откуда пришёл. Остальное игра узнает по ходу: характер складывается из книг и реплик.",
      "properties": {
        "name": {
          "title": "Имя героя",
          "description": "Так его будут звать в этом мире.",
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "estate": {
          "title": "Происхождение",
          "description": "Кем он родился здесь: от этого зависит, как его встретят.",
          "$ref": "#/$defs/estate"
        },
        "arrival": {
          "title": "Как он здесь оказался",
          "description": "Что помнит сам герой о своём появлении.",
          "$ref": "#/$defs/arrival"
        },
        "origin": {
          "title": "Откуда он пришёл",
          "description": "Его прежняя жизнь: страна и занятие. Можно пропустить.",
          "type": "string",
          "maxLength": 120
        },
        "books": {
          "title": "Любимые книги",
          "description": "По ним игра поймёт его характер. Можно пропустить.",
          "type": "string",
          "maxLength": 200
        }
      },
      "title": "Герой"
    }
  }
}
